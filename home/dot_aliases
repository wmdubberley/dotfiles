alias arr_start='sudo service radarr start && sudo service sonarr start && sudo service prowlarr start && sudo service qbittorrent start'
alias bc='bc -l'
alias mkdir='mkdir -pv'
alias h='history'
alias j='jobs -l'
alias ports='netstat -tulanp'
alias root='sudo -i'
alias su='sudo -i'
alias wget='wget -c'
alias c='clear'
alias hg='history | grep $1'
alias untar='tar -zxvf $1'
alias wtr='curl wttr.in'
alias lb-dev='liquibase --defaultsFile=dev.properties'
